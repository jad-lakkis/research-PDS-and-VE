.venv/
__pycache__/
*.pyc
.claude/settings.local.json

# Training outputs: binary model.zip/vecnormalize.pkl checkpoints don't
# belong in git and grow unbounded across sweep arms - pull results off
# RunPod directly (runpodctl send / scp), not via git. data/ (the .mat
# dataset) stays tracked - it's small (79MB) and needed for training.
runs/
other/archived_runs/
runpod_results/
runpod_results_v2/
runpod_results_summary/
runpod_pds_results/
ent_tests/
EXP1_D_VS_A/
run_D_clean_results/
baseline_A_key_metrics/
FINAL_PART1_EXP/
FINAL_PART1_EXP_M/
*.zip
*.pkl

# Empty sentinel files from local auto-continue loop control, not
# meaningful outside this machine's now-superseded local sweep.
other/STOP_*

# Raw training-loop console logs (multi-MB, generated output, not
# meaningful outside this machine's now-superseded local sweep).
other/*.log

# Manuscript drafts stay local - never pushed (an earlier draft is already
# in the history up to commit e50e136; this only stops new versions).
paper/

# Weekly progress summaries for meetings - local only, never pushed.
WEEKLY_PROGRESS_*/

# Later experiment result folders (pulled off RunPod / built locally for
# meetings and plots) - ~900 MB together, regenerated by the plot/analysis
# scripts, not needed to train. Same reasoning as the result folders above.
EXP3_PDS_VE_COMPARISON/
EXP4_SOLO/
EXP5_PPO_NEWPDS_VE/
EXP4_PDS_CRITIC_FIX/
EXPERIMENT_X_drop_seed6/
expirments_ALL/
X_RES_EXP_KEY/

# Console logs of the video-survey / Lumos5G analysis scripts. The CSV/PNG
# results in VIDEO_SURVEY/ stay tracked (small; config.py's Lumos5G budget
# comments point at VIDEO_SURVEY/lumos5g/).
VIDEO_SURVEY/**/*_log.txt
